ut_tokens":399,"output_tokens":0}],"input_tokens":419,"output_tokens":0},"rs_05b7b37e15b0efa3016aa0e2a244b887d1ad5320f94e129555":{"cache_write_tokens":0,"cached_tokens":62,"input_tokens":62,"output_tokens":0},"msg_05b7b37e15b0efa3016aa0e2a4910087d194d3938b24a2f7ed":{"cache_write_tokens":0,"cached_tokens":49,"content":[{"cache_write_tokens":0,"cached_tokens":49,"input_tokens":49,"output_tokens":0}],"input_tokens":49,"output_tokens":0},"ctc_05b7b37e15b0efa3016aa0e2a5fed487d185cb939a534be271":{"cache_write_tokens":0,"cached_tokens":118,"input_tokens":336,"output_tokens":0},"ctco_01a08475-8743-7033-8bb5-e6c1d57b816c":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":0}],"input_tokens":22,"output_tokens":0},"ctc_05b7b37e15b0efa3016aa0e2b3d59087d1ac69bf7389969dcf":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":145,"output_tokens":0},"ctco_01a08475-ac49-7492-8fdf-a21bdf5eac70":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":20,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":4,"output_tokens":0},{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":6,"output_tokens":0}],"input_tokens":30,"output_tokens":0},"rs_05b7b37e15b0efa3016aa0e2bdc32487d1ad5219772635474e":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":2,"output_tokens":7},"msg_05b7b37e15b0efa3016aa0e2be110087d1807b170f384a593d":{"cache_write_tokens":0,"cached_tokens":0,"content":[{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":46}],"input_tokens":0,"output_tokens":46},"ctc_05b7b37e15b0efa3016aa0e2bfb3f087d181cc8dff6f9d327b":{"cache_write_tokens":0,"cached_tokens":0,"input_tokens":0,"output_tokens":69}}},"input_tokens":14241,"input_tokens_details":{"cache_write_tokens":0,"cached_tokens":13824},"output_tokens":122,"output_tokens_details":{"reasoning_tokens":7},"total_tokens":14363},"user":null,"metadata":{}},"sequence_number":108}

