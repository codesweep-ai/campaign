data: {"delta":{"partial_json":"{\"command\": \"cat \u003e /tmp/readback.json \u003c\u003c 'EOF'\\n{\\\"member\\\":\\\"dev\\\",\\\"role\\\":\\\"agent\\\",\\\"branch\\\":\\\"cs-sandbox/<DEV:1>.<GROUP:1>\\\",\\\"missing\\\":[],\\\"goal\\\":\\\"Implement whatever work each dispatch in campaign csrclkey assigns against the subject repository, committing real changes and reporting honestly.\\\",\\\"scope\\\":\\\"I own the subject repository clone at ~/subject on my own branch, and I must not touch other members' work, the orchestrator, or expand scope beyond what a dispatch explicitly asks.\\\",\\\"obligations\\\":\\\"I must commit my work to my own branch and reply to each dispatch describing what I did; if I don't commit or reply, my work is invisible to the orchestrator and I'll simply be prodded to reply again since my branch and reply are the only durable records that survive.\\\"}\\nEOF\\ncat /tmp/readback.json | python3 -m json.tool \u003e /dev/null \u0026\u0026 echo \\\"valid json\\\"\"}","type":"input_json_delta"},"index":1,"type":"content_block_delta"}

