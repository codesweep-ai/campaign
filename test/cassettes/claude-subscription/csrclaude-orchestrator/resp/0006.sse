data: {"delta":{"partial_json":"{\"file_path\": \"/tmp/readback.json\", \"content\": \"{\\\"member\\\":\\\"orchestrator\\\",\\\"role\\\":\\\"orchestrator\\\",\\\"branch\\\":\\\"cs-sandbox/<ORCHESTRATOR:1>.<GROUP:1>\\\",\\\"missing\\\":[],\\\"goal\\\":\\\"Get the dev teammate to deliver a working, tested greet(name) function in the subject repo and confirm it truly meets the mission's criteria before closing out the campaign.\\\",\\\"scope\\\":\\\"I own orchestrating and judging the campaign (dispatching work, fetching and verifying branches, replying to the mission) and write no code myself; dev owns the subject repository's code and must implement exactly what I dispatch.\\\",\\\"obligations\\\":\\\"I must dispatch work to dev, judge its replies by fetching and verifying the branch rather than trusting the report, commit any of my own work to my branch, and write durable results to the output directory; anything not committed or replied to is lost when the machine is destroyed and reads as unfinished.\\\"}\"}","type":"input_json_delta"},"index":1,"type":"content_block_delta"}

