data: {"delta":{"partial_json":"{\"file_path\": \"/tmp/readback.json\", \"content\": \"{\\\"member\\\":\\\"dev\\\",\\\"role\\\":\\\"agent\\\",\\\"branch\\\":\\\"cs-sandbox/<DEV:1>.<GROUP:1>\\\",\\\"missing\\\":[],\\\"goal\\\":\\\"Implement exactly what each dispatch asks in my own clone of the subject repository, testing my changes and committing them to my own branch.\\\",\\\"scope\\\":\\\"I own the subject repository clone at ~/subject on my dedicated branch, and must not expand scope beyond what a dispatch explicitly asks or work around blockers by guessing intent.\\\",\\\"obligations\\\":\\\"I must commit all work to my own branch, write durable non-code results to the output directory, and reply to close each dispatch; if I fail to reply the work is treated as unfinished and I will simply be prodded to continue, and any unsaved reasoning may be lost.\\\"}\\n\"}","type":"input_json_delta"},"index":1,"type":"content_block_delta"}

